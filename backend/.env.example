# =====================================================
# Chatbot backend — environment variables
# parse 2: SQLite + MiniMax-M3 (OpenAI compatible)
# =====================================================

APP_ENV=dev
APP_NAME=chatbot-backend
APP_HOST=0.0.0.0
APP_PORT=8000

# --- DB ---
DATABASE_URL=sqlite:///./data/app.db

# --- MiniMax-M3 ---
# Obtain MINIMAX_API_KEY from the MiniMax dashboard.
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
# parse 2: only CHAT_MODEL is required for /v1/chat/completions.
# parse 3: REASONING_MODEL becomes required for `mode="reasoning"`.
MINIMAX_CHAT_MODEL=MiniMax-M3-mini
MINIMAX_REASONING_MODEL=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO